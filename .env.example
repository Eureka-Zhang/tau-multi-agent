# tau-bench environment variables (template).
# Copy this file to ".env" and fill in the values you need:
#     cp .env.example .env
# The .env file is loaded automatically on startup (see tau_bench/__init__.py)
# and is git-ignored so your secrets are not committed.

# ---------------------------------------------------------------------------
# OpenAI / OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# API key for OpenAI or any OpenAI-compatible gateway/proxy.
OPENAI_API_KEY=

# Optional: base URL of an OpenAI-compatible endpoint. Leave unset to use the
# official OpenAI API. Example for a self-hosted/proxy gateway:
#   OPENAI_BASE_URL=https://your-gateway.example.com/v1
# Both OPENAI_BASE_URL and OPENAI_API_BASE are accepted (they are mirrored).
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Google (Gemini)
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Mistral
# ---------------------------------------------------------------------------
# MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# AnyScale (OpenAI-compatible)
# ---------------------------------------------------------------------------
# ANYSCALE_API_KEY=

# ---------------------------------------------------------------------------
# Model configuration for the four roles (all configurable here).
# For the two-agent-handoff strategy you can configure everything via .env and
# never pass model flags on the CLI.
# ---------------------------------------------------------------------------
# 1) Agent A -- upstream information / policy agent
# TAU_AGENT_A_MODEL=gpt-4o
# TAU_AGENT_A_MODEL_PROVIDER=openai
# 2) Agent B -- downstream execution agent
# TAU_AGENT_B_MODEL=gpt-4o
# TAU_AGENT_B_MODEL_PROVIDER=openai
# 3) Handoff builder -- context compressor that builds the handoff package
# TAU_HANDOFF_BUILDER_MODEL=gpt-4o
# TAU_HANDOFF_BUILDER_MODEL_PROVIDER=openai
# 4) User simulator
# TAU_USER_MODEL=gpt-4o
# TAU_USER_MODEL_PROVIDER=openai

# Optional base fallback for the three agent roles (A / B / builder): any role
# left unset above falls back to these. Also used by non-handoff strategies.
# TAU_MODEL=gpt-4o
# TAU_MODEL_PROVIDER=openai
# Optional default environment (retail / airline)
# TAU_ENV=retail
